{
	"name": "oracle-cdc-fer-v4 ",
	"config": {
		"connector.class": "io.confluent.connect.oracle.cdc.OracleCdcSourceConnector",
		"key.converter": "org.hifly.kafka.ByteArrayAndStringConverter", 
		"value.converter": "org.apache.kafka.connect.json.JsonConverter", 
		"oracle.server": "COLRIDDB.COLRISORSE.INT", 
		"oracle.port": "1521",
		"oracle.sid": "CRID19DB",
		"oracle.username": "CFLTCONN",
		"oracle.password": "CFLTCONN",
		"start.from": "force_current",
		"redo.log.topic.name": "redo_fer",
		"redo.log.consumer.bootstrap.servers": "colcfltbrk1.colrisorse.int:9092, colcfltbrk2.colrisorse.int:9092, colcfltbrk3.colrisorse.int:9092",
		"redo.log.consumer.security.protocol": "SASL_PLAINTEXT",
		"redo.log.consumer.sasl.mechanism": "PLAIN",
		"redo.log.consumer.sasl.jaas.config": "org.apache.kafka.common.security.plain.PlainLoginModule required username='kafka-connect' password='xFpZlkW0spSLGHZJFoI=';",
		"numeric.mapping": "best_fit_or_string",
		"emit.tombstone.on.delete": "true",
		"behavior.on.unparsable.statement": "log",
		"oracle.date.mapping": "timestamp",
		"heartbeat.interval.ms": "600000",
    	"heartbeat.topic.name": "oracle-heartbeat-topic",
    	"table.topic.name.template": "${schemaName}.${tableName}",
		"table.inclusion.regex": "CRID19DB.FER_ELE.(FER_DATI_PRELIMINARI|FER_PRATICHE|FER_RIEP_ACQ_DATI_GR|FER_UNITA_PRODUTTIVE_IMP|FER2_CONF_PARAM_MIS|FER_REL_PRATICHE_SR|FER_SEZIONI_UP_IMP)",
		"topic.creation.default.partitions": "1",
		"topic.creation.redo.partitions": "1",
		"topic.creation.redo.include": "redo_fer",
		"topic.creation.default.replication.factor": "3",
		"topic.creation.redo.replication.factor": "1",
		"topic.creation.enable": "true",
		"key.converter.schemas.enable": "false",
		"value.converter.schemas.enable": "false"
	}
}