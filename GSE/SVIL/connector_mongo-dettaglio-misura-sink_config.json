{
  "name": "mongo-dettaglio-misura-sink-v1",
  "config": {
    "connection.uri": "mongodb://root:r00tsvil2021!@svilmongodb.colrisorse.int/Misure?tls=false&directConnection=true&authSource=admin",
    "connector.class": "org.hifly.kafka.mongo.sink.CustomMongoSinkConnector",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "key.converter.schemas.enable": "false",
    "transforms": "HoistKey,TimestampConverter1,TimestampConverter2,TimestampConverter3",
    "errors.tolerance": "all",
    "topics": "RID_DETTAGLIO_MISURA_PERIMETRO_JSON",
    "transforms.TimestampConverter1.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.TimestampConverter1.target.type": "Timestamp",
    "transforms.TimestampConverter1.field": "periodo",
    "transforms.TimestampConverter1.format": "yyyy-MM-dd'T'HH:mm:ss",
    "transforms.TimestampConverter2.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.TimestampConverter2.target.type": "Timestamp",
    "transforms.TimestampConverter2.field": "dataMisuraRif",
    "transforms.TimestampConverter2.format": "yyyy-MM-dd'T'HH:mm:ss",
    "transforms.TimestampConverter3.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.TimestampConverter3.target.type": "Timestamp",
    "transforms.TimestampConverter3.field": "dataAggiornamento",
    "transforms.TimestampConverter3.format": "yyyy-MM-dd'T'HH:mm:ss",
    "transforms.HoistKey.type": "org.apache.kafka.connect.transforms.HoistField$Key",
    "transforms.HoistKey.field": "_id",
    "database": "Misure",
    "collection": "misure-dettaglio",
    "doc.id.name": "testataId",
    "doc.array.field.name": "misure",
    "doc.array.field.dedup.keys": "ts,tipoOra",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.topic.name": "dlq-mongo-dettaglio-misura"
  }
}