{
  "name": "mongo-cdc-fer-dettaglio-misura-sink-v4",
  "config": {
    "connector.class": "com.mongodb.kafka.connect.MongoSinkConnector",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "transforms": "renameKey, jsonCLOBFlatten, TimestampConverter1, TimestampConverter2, TimestampConverter3",
    "errors.tolerance": "all",
    "topics": "FER2.CDC_DETTAGLIO_MISURA",
    "errors.deadletterqueue.topic.name": "dlq-mongo-cdc-fer-dettaglio-misura",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.context.headers.enable": "true",
    "transforms.renameKey.type": "org.apache.kafka.connect.transforms.ReplaceField$Key",
    "transforms.renameKey.renames": "testataId:_id",
    "transforms.jsonCLOBFlatten.type": "org.hifly.kafka.smt.ExplodeJsonString",
    "transforms.jsonCLOBFlatten.valuename": "JSON_CLOB",
    "transforms.TimestampConverter1.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.TimestampConverter1.target.type": "Timestamp",
    "transforms.TimestampConverter1.field": "periodo",
    "transforms.TimestampConverter1.format": "yyyy-MM-dd'T'HH:mm:ss",
    "transforms.TimestampConverter2.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.TimestampConverter2.target.type": "Timestamp",
    "transforms.TimestampConverter2.field": "dataAggiornamento",
    "transforms.TimestampConverter2.format": "yyyy-MM-dd'T'HH:mm:ss",
    "transforms.TimestampConverter3.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.TimestampConverter3.target.type": "Timestamp",
    "transforms.TimestampConverter3.field": "dataMisuraRif",
    "transforms.TimestampConverter3.format": "yyyy-MM-dd'T'HH:mm:ss",
    "connection.uri": "mongodb://root:r00tsvil2021!@svilmongodb.colrisorse.int:27017/admin?retryWrites=false&connectTimeoutMS=10000&authSource=admin&authMechanism=SCRAM-SHA-256&tls=false&directConnection=true",
    "database": "Misure",
    "collection": "misure-dettaglio",
    "delete.on.null.values": "true",
    "writemodel.strategy": "org.hifly.kafka.mongo.writestrategy.UpdateIfNewerByDateStrategy",
    "delete.writemodel.strategy": "com.mongodb.kafka.connect.sink.writemodel.strategy.DeleteOneDefaultStrategy",
    "post.processor.chain": "com.mongodb.kafka.connect.sink.processor.DocumentIdAdder",
    "document.id.strategy": "com.mongodb.kafka.connect.sink.processor.id.strategy.ProvidedInKeyStrategy",
    "document.id.strategy.overwrite.existing": "true",
    "mongo.errors.log.enable": "true",
    "key.converter.schemas.enable": "false",
    "upsert.date.field.name": "dataAggiornamento",
    "publish.full.document.only": "true"
  }
